---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CatalogModal from '../components/CatalogModal.astro';
import HistoryModal from '../components/HistoryModal.astro';
import AuthModal from '../components/AuthModal.astro';

export const prerender = false;
---

<Layout title="ThermalPOS Pro - Kasir & Printer Thermal 58mm/80mm Fullstack Astro">
  <Header />

  <main class="app-container">
    <!-- LEFT COLUMN: Form Editor -->
    <div class="form-column">

      <!-- Template Presets -->
      <div class="panel-card" style="padding: 14px 20px;">
        <label style="margin-bottom: 8px; display: block; font-weight: 600; font-size: 0.85rem;">⚡ Pilih Template Usaha:</label>
        <div class="template-pills">
          <button type="button" class="template-pill active" data-template="benthenk">🖥️ Benthenk Komputer</button>
          <button type="button" class="template-pill" data-template="spbu">⛽ SPBU Pertamina</button>
          <button type="button" class="template-pill" data-template="cafe">☕ Cafe & Coffee</button>
          <button type="button" class="template-pill" data-template="resto">🍰 Kuliner & Resto</button>
          <button type="button" class="template-pill" data-template="retail">🛒 Minimarket / Retail</button>
          <button type="button" class="template-pill" data-template="laundry">🧺 Laundry Kiloan</button>
          <button type="button" class="template-pill" data-template="service">🔧 Bengkel & Service</button>
        </div>
      </div>

      <!-- RETAIL STORE FORM PANELS -->
      <div id="retail-editor-panel">
        <!-- Store & Receipt Info -->
        <div class="panel-card">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding-bottom: 10px; border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
            <h2 class="panel-card-title" style="margin-bottom: 0; padding-bottom: 0; border: none;">
            <span aria-hidden="true">🏪</span> Informasi Toko & Outlet
            <span class="badge">Database</span>
          </h2>
          <button type="button" class="btn btn-outline btn-sm" id="btn-save-store-db" title="Simpan pengaturan ke Database Supabase">
            <span aria-hidden="true">💾</span> Simpan Profil Toko
          </button>
        </div>
        <div class="form-grid">
          <div class="form-group">
            <label for="store-name">Nama Toko / Usaha</label>
            <input type="text" id="store-name" value="UD BENTHENK KOMPUTER" placeholder="Nama Usaha" />
          </div>
          <div class="form-group">
            <label for="store-tagline">Slogan / Keterangan (Opsional)</label>
            <input type="text" id="store-tagline" value="" placeholder="Komp Balikpapan Baru..." />
          </div>
          <div class="form-group col-span-2">
            <label for="store-address">Alamat Toko</label>
            <input type="text" id="store-address" value="Komp Balikpapan Baru Blok C No.6" placeholder="Alamat lengkap..." />
          </div>
          <div class="form-group">
            <label for="store-phone">No. Telp / WhatsApp</label>
            <input type="text" id="store-phone" value="Telp: 085251822145 | 087886935070" placeholder="08xx-xxxx-xxxx" />
          </div>
          <div class="form-group">
            <label for="store-logo-input">Upload Logo (Opsional)</label>
            <input type="file" id="store-logo-input" accept="image/*" />
          </div>
        </div>
      </div>

      <!-- Transaction Info -->
      <div class="panel-card">
        <h2 class="panel-card-title">
          <span aria-hidden="true">📋</span> Data Transaksi
          <span class="badge">Metadata</span>
        </h2>
        <div class="form-grid">
          <div class="form-group">
            <label for="tx-no">No. Nota / Invoice</label>
            <div style="display: flex; gap: 6px;">
              <input type="text" id="tx-no" value="INV/2026/10/0158" style="flex:1;" />
              <button type="button" class="btn btn-outline btn-sm" id="btn-gen-tx" title="Generate Nomor Otomatis" aria-label="Acak Nomor Nota">🎲</button>
            </div>
          </div>
          <div class="form-group">
            <label for="tx-date">Tanggal Transaksi</label>
            <input type="text" id="tx-date" value="2026-10-13" />
          </div>
          <div class="form-group">
            <label for="tx-time">Jam Transaksi</label>
            <input type="text" id="tx-time" value="11:05" />
          </div>
          <div class="form-group">
            <label for="tx-cashier">Kasir (Shift / Nama)</label>
            <input type="text" id="tx-cashier" value="pagi" placeholder="pagi / siang / nama kasir" />
          </div>
          <div class="form-group">
            <label for="tx-sales">Sales / Pramuniaga</label>
            <input type="text" id="tx-sales" value="wiwik" placeholder="wiwik / nama sales" />
          </div>
          <div class="form-group">
            <label for="tx-customer">Pelanggan (Opsional)</label>
            <input type="text" id="tx-customer" value="" placeholder="Nama pelanggan / umum" />
          </div>
        </div>
      </div>

      <!-- Items Section -->
      <div class="panel-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
          <h2 class="panel-card-title" style="margin-bottom: 0; padding-bottom: 0; border: none;">
            <span aria-hidden="true">🛍️</span> Daftar Item / Produk
          </h2>
          <button type="button" class="btn btn-emerald btn-sm" id="btn-add-item">
            <span aria-hidden="true">➕</span> Tambah Item
          </button>
        </div>

        <div class="items-table-wrapper">
          <table class="items-table">
            <thead>
              <tr>
                <th style="width: 40%;">Nama Barang / Jasa</th>
                <th style="width: 15%;">Qty</th>
                <th style="width: 25%;">Harga Satuan</th>
                <th style="width: 15%;">Total</th>
                <th style="width: 5%;"></th>
              </tr>
            </thead>
            <tbody id="items-tbody">
              <!-- Item rows injected dynamically -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- Summary & Payment -->
      <div class="panel-card">
        <h2 class="panel-card-title">
          <span aria-hidden="true">💳</span> Pembayaran & Kalkulasi
          <span class="badge">Ringkasan</span>
        </h2>

        <div class="form-grid" style="margin-bottom: 16px;">
          <div class="form-group">
            <label for="payment-method">Metode Bayar</label>
            <select id="payment-method">
              <option value="TUNAI">TUNAI (Cash)</option>
              <option value="QRIS" selected>QRIS</option>
              <option value="DEBIT">Kartu Debit</option>
              <option value="TRANSFER">Transfer Bank</option>
              <option value="KREDIT">Kartu Kredit</option>
            </select>
          </div>
          <div class="form-group">
            <label for="pay-amount">Nominal Bayar (Rp)</label>
            <input type="number" id="pay-amount" value="249000" min="0" step="1000" />
          </div>
          <div class="form-group col-span-2" style="justify-content: flex-end;">
            <div style="display: flex; gap: 6px;">
              <button type="button" class="btn btn-outline btn-sm" id="btn-pay-exact">Uang Pas</button>
              <button type="button" class="btn btn-outline btn-sm" id="btn-pay-50k">50k</button>
              <button type="button" class="btn btn-outline btn-sm" id="btn-pay-100k">100k</button>
            </div>
          </div>
        </div>

        <div class="summary-box">
          <div class="summary-row">
            <span>Subtotal Barang:</span>
            <strong id="sum-subtotal">Rp 0</strong>
          </div>
          <div class="summary-row total">
            <span>TOTAL:</span>
            <span id="sum-grandtotal">Rp 0</span>
          </div>
        </div>
      </div>

      <!-- Footer & Printer Options -->
      <div class="panel-card">
        <h2 class="panel-card-title">
          <span aria-hidden="true">⚙️</span> Pengaturan Footer & Kustomisasi Nota
        </h2>
        <div class="form-grid">
          <div class="form-group col-span-2">
            <label for="footer-note">Pesan Terima Kasih / Keterangan Bawah</label>
            <textarea id="footer-note" rows="2">Barang yang sudah dibeli tidak dapat ditukar&#10;atau dikembalikan&#10;Terima Kasih&#10;WA Admin : 085251822145</textarea>
          </div>
          <div class="form-group">
            <label for="wifi-info">Info Wi-Fi (Opsional)</label>
            <input type="text" id="wifi-info" value="" placeholder="SSID & Password" />
          </div>
          <div class="form-group">
            <label for="qr-text">Isi QR Code (URL / Teks / WA)</label>
            <input type="text" id="qr-text" value="" placeholder="Link web / WA..." />
          </div>
          <div class="form-group">
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 0.85rem;">
              <input type="checkbox" id="show-barcode" /> Tampilkan Barcode No. Nota
            </label>
          </div>
          <div class="form-group">
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 0.85rem;">
              <input type="checkbox" id="show-qrcode" /> Tampilkan QR Code Footer
            </label>
          </div>
        </div>
      </div>
      <!-- END RETAIL STORE FORM PANELS -->

      <!-- SPBU PERTAMINA FORM PANEL -->
      <div id="spbu-editor-panel" style="display: none;">
        <!-- SPBU Info Card -->
        <div class="panel-card">
          <h2 class="panel-card-title">
            <span aria-hidden="true">⛽</span> Informasi SPBU Pertamina
          </h2>
          <div class="form-grid">
            <div class="form-group">
              <label for="spbu-code">Kode SPBU (Baris 1)</label>
              <input type="text" id="spbu-code" value="6476128" placeholder="6476128" />
            </div>
            <div class="form-group">
              <label for="spbu-name">Nama SPBU (Baris 2)</label>
              <input type="text" id="spbu-name" value="SPBU 64/6128" placeholder="SPBU 64/6128" />
            </div>
            <div class="form-group col-span-2">
              <label for="spbu-address">Alamat SPBU (Baris 3)</label>
              <input type="text" id="spbu-address" value="JALAN SULTAN HASANUDIN" placeholder="Alamat SPBU..." />
            </div>
            <div class="form-group">
              <label for="spbu-shift">Shift</label>
              <input type="text" id="spbu-shift" value="1" placeholder="1" />
            </div>
            <div class="form-group">
              <label for="spbu-notrans">No. Transaksi</label>
              <input type="text" id="spbu-notrans" value="138762" placeholder="138762" />
            </div>
            <div class="form-group col-span-2">
              <label for="spbu-time">Waktu Transaksi (DD/MM/YYYY HH:MM:SS)</label>
              <input type="text" id="spbu-time" value="12/10/2026 10:35:26" placeholder="12/10/2026 10:35:26" />
            </div>
          </div>
        </div>

        <!-- Pengisian BBM Card -->
        <div class="panel-card">
          <h2 class="panel-card-title">
            <span aria-hidden="true">🛢️</span> Pengisian & Jenis BBM
          </h2>
          <div class="form-grid">
            <div class="form-group">
              <label for="spbu-pompa">Pulau / Pompa</label>
              <input type="text" id="spbu-pompa" value="6" placeholder="6" />
            </div>
            <div class="form-group">
              <label for="spbu-operator">Operator</label>
              <input type="text" id="spbu-operator" value="SALWA" placeholder="SALWA" />
            </div>
            <div class="form-group">
              <label for="spbu-fuel">Jenis BBM</label>
              <select id="spbu-fuel">
                <option value="PERTALITE" selected>PERTALITE (Subsidi)</option>
                <option value="SOLAR">BIO SOLAR (Subsidi)</option>
                <option value="PERTAMAX">PERTAMAX</option>
                <option value="PERTAMAX TURBO">PERTAMAX TURBO</option>
                <option value="DEXLITE">DEXLITE</option>
                <option value="PERTAMINA DEX">PERTAMINA DEX</option>
              </select>
            </div>
            <div class="form-group">
              <label for="spbu-volume">Volume (Liter)</label>
              <input type="number" id="spbu-volume" step="0.01" value="3.00" min="0.01" />
            </div>
          </div>
        </div>

        <!-- Harga & Subsidi Card -->
        <div class="panel-card">
          <h2 class="panel-card-title">
            <span aria-hidden="true">💰</span> Harga & Subsidi (Rp/Liter)
          </h2>
          <div class="form-grid">
            <div class="form-group">
              <label for="spbu-price-nonsubsidi">Harga Non Subsidi (Rp/L)</label>
              <input type="number" id="spbu-price-nonsubsidi" value="18101" />
            </div>
            <div class="form-group">
              <label for="spbu-price-subsidi">Subsidi Pemerintah (Rp/L)</label>
              <input type="number" id="spbu-price-subsidi" value="8101" />
            </div>
            <div class="form-group col-span-2">
              <label for="spbu-price-jual">Harga Jual Konsumen (Rp/L)</label>
              <input type="number" id="spbu-price-jual" value="10000" />
            </div>
          </div>

          <div style="margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.06);" class="form-grid">
            <div class="form-group">
              <label for="spbu-pay-method-input">Metode Bayar</label>
              <input type="text" id="spbu-pay-method-input" value="CASH" placeholder="CASH / QRIS" />
            </div>
            <div class="form-group">
              <label for="spbu-pay-amount-input">Nominal Bayar (Rp)</label>
              <input type="number" id="spbu-pay-amount-input" value="30000" />
            </div>
          </div>

          <div class="summary-box" style="margin-top: 12px;">
            <div class="summary-row">
              <span>Total Tanpa Subsidi:</span>
              <strong id="spbu-calc-nonsubsidi">Rp 54.303</strong>
            </div>
            <div class="summary-row">
              <span>Total Subsidi Pemerintah:</span>
              <strong id="spbu-calc-subsidi" style="color: #34d399;">Rp 24.303</strong>
            </div>
            <div class="summary-row total">
              <span>Dibayar Konsumen:</span>
              <span id="spbu-calc-dibayar">Rp 30.000</span>
            </div>
          </div>
        </div>
      </div>
      <!-- END SPBU PERTAMINA FORM PANEL -->

    </div>

    <!-- RIGHT COLUMN: Realtime Live Thermal Receipt Preview -->
    <div class="preview-column">

      <div class="preview-toolbar" style="flex-wrap: wrap; gap: 8px;">
        <div class="paper-controls">
          <button type="button" class="btn btn-outline btn-sm active-paper" id="btn-paper-58mm">58 mm (POS)</button>
          <button type="button" class="btn btn-outline btn-sm" id="btn-paper-80mm">80 mm</button>
        </div>
        <div style="display: flex; align-items: center; gap: 8px;">
          <label for="spacing-selector" style="font-size: 11px; color: var(--text-muted);">Spasi:</label>
          <select id="spacing-selector" style="padding: 3px 8px; font-size: 11px; height: 28px;">
            <option value="tight" selected>Rapat (Persis Foto)</option>
            <option value="normal">Normal</option>
            <option value="loose">Renggang</option>
          </select>
          <label for="ink-selector" style="font-size: 11px; color: var(--text-muted);">Tinta:</label>
          <select id="ink-selector" style="padding: 3px 8px; font-size: 11px; height: 28px;">
            <option value="heavy" selected>Pekat Thermal</option>
            <option value="dotmatrix">Dot Matrix</option>
          </select>
        </div>
      </div>

      <div class="preview-scroll-area">
        <div class="thermal-paper-wrap width-58mm" id="receipt-wrap">
          <div class="thermal-paper" id="receipt-paper">

            <!-- RETAIL RECEIPT VIEW -->
            <div id="receipt-retail-view">
              <!-- Store Header -->
              <div class="t-header">
                <img id="t-logo" class="t-logo-img" src="/img/ben.jpeg" alt="Logo Benthenk" />
                <div class="t-title" id="t-store-name">UD BENTHENK KOMPUTER</div>
                <div class="t-subtitle" id="t-store-tagline" style="display: none;"></div>
                <div class="t-address" id="t-store-address">Komp Balikpapan Baru Blok C No.6</div>
                <div class="t-address" id="t-store-phone">Telp: 085251822145 | 087886935070</div>
              </div>

              <div class="t-divider"></div>

              <!-- Transaction Meta -->
              <div class="t-meta">
                <div class="t-meta-grid">
                  <span><span id="t-tx-no">INV/2026/10/0158</span></span>
                  <span></span>
                </div>
                <div class="t-meta-grid">
                  <span id="t-tx-date">2026-10-13</span>
                  <span id="t-tx-cashier-row">Kasir: <span id="t-tx-cashier">pagi</span></span>
                </div>
                <div class="t-meta-grid">
                  <span id="t-tx-time">11:05</span>
                  <span id="t-tx-sales-row">Sales: <span id="t-tx-sales">wiwik</span></span>
                </div>
                <div class="t-meta-grid" id="t-customer-row" style="display: none;">
                  <span>Pelanggan:</span>
                  <span id="t-tx-customer"></span>
                </div>
              </div>

              <div class="t-divider"></div>

              <!-- Item List -->
              <div class="t-items-list" id="t-items-container">
                <!-- Rendered dynamically -->
              </div>

              <div class="t-divider"></div>

              <!-- Summary Calculations -->
              <div class="t-summary" id="t-summary-box">
                <div class="t-summary-row" id="t-row-subtotal">
                  <span>Subtotal</span>
                  <span id="t-sum-subtotal">900.000</span>
                </div>
                <div class="t-summary-row bold" id="t-row-total">
                  <span>TOTAL</span>
                  <span id="t-sum-grandtotal">900.000</span>
                </div>
                <div class="t-divider" id="t-divider-payment"></div>
                <div class="t-summary-row" id="t-row-pay">
                  <span id="t-pay-method">QRIS</span>
                  <span id="t-pay-amount">900.000</span>
                </div>
              </div>

              <div class="t-divider"></div>

              <!-- Footer Notes & Barcode/QR -->
              <div class="t-footer">
                <div id="t-footer-text" class="t-footer-lines">Barang yang sudah dibeli tidak dapat ditukar&#10;atau dikembalikan&#10;Terima Kasih&#10;WA Admin : 085251822145</div>
                <div id="t-wifi-text" style="display: none; margin-top: 6px; font-size: 10.5px;"></div>
                <div class="t-barcode-wrap" id="t-barcode-container" style="display: none;"></div>
                <div class="t-qrcode-wrap" id="t-qrcode-container" style="display: none;"></div>
              </div>
            </div>
            <!-- END RETAIL RECEIPT VIEW -->

            <!-- SPBU PERTAMINA RECEIPT VIEW -->
            <div id="receipt-spbu-view" class="spbu-receipt" style="display: none;">
              <!-- Pertamina Logo SVG -->
              <div class="spbu-logo-wrap">
                <svg class="spbu-logo-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 30" width="125" height="24">
                  <g fill="#000">
                    <polygon points="12,2 26,2 19,12 5,12" />
                    <path d="M19.5,13.5 L31.5,13.5 C32.5,13.5 33,14 32.5,15 L28,22 C27.5,23 26.5,23.5 25,23.5 L14,23.5 L17.5,18 L24,18 C24.5,18 24.8,17.8 25,17.5 L26,15.5 L18,15.5 Z" />
                    <polygon points="6,19 18,19 12,28 0,28" />
                  </g>
                  <text x="38" y="21" font-family="'Arial Black', Arial, sans-serif" font-weight="900" font-size="15" letter-spacing="0.5" fill="#000">PERTAMINA</text>
                </svg>
              </div>

              <div class="spbu-header-center">
                <div class="spbu-code" id="t-spbu-code">6476128</div>
                <div class="spbu-name" id="t-spbu-name">SPBU 64/6128</div>
                <div class="spbu-address" id="t-spbu-address">JALAN SULTAN HASANUDIN</div>
              </div>

              <div class="spbu-meta">
                <div class="spbu-row-between">
                  <span>Shift: <span id="t-spbu-shift">1</span></span>
                  <span>No. Trans: <span id="t-spbu-notrans">138762</span></span>
                </div>
                <div class="spbu-row-between">
                  <span>Waktu: <span id="t-spbu-time">12/10/2026 10:35:26</span></span>
                  <span></span>
                </div>
              </div>

              <div class="spbu-divider"></div>

              <!-- Pengisian Section -->
              <div class="spbu-section">
                <div class="spbu-col-row">
                  <span class="spbu-label-fill">Pulau/Pompa</span>
                  <span class="spbu-sep">:</span>
                  <span class="spbu-val" id="t-spbu-pompa">6</span>
                </div>
                <div class="spbu-col-row">
                  <span class="spbu-label-fill">Operator</span>
                  <span class="spbu-sep">:</span>
                  <span class="spbu-val" id="t-spbu-operator">SALWA</span>
                </div>
                <div class="spbu-col-row">
                  <span class="spbu-label-fill">Jenis BBM</span>
                  <span class="spbu-sep">:</span>
                  <span class="spbu-val" id="t-spbu-fuel">PERTALITE</span>
                </div>
                <div class="spbu-col-row">
                  <span class="spbu-label-fill">Volume</span>
                  <span class="spbu-sep">:</span>
                  <span class="spbu-val" id="t-spbu-volume">3.00 liter</span>
                </div>
              </div>

              <div class="spbu-divider"></div>

              <!-- Informasi Harga BBM Section -->
              <div class="spbu-section">
                <div class="spbu-section-title">Informasi Harga BBM (Rp/Liter)</div>
                <div class="spbu-col-row">
                  <span class="spbu-label-price">Harga Non Subsidi</span>
                  <span class="spbu-sep">:</span>
                  <span class="spbu-val-num" id="t-spbu-price-nonsubsidi">18,101</span>
                </div>
                <div class="spbu-col-row">
                  <span class="spbu-label-price">Subsidi Pemerintah</span>
                  <span class="spbu-sep">:</span>
                  <span class="spbu-val-num" id="t-spbu-price-subsidi">8,101</span>
                </div>
                <div class="spbu-col-row">
                  <span class="spbu-label-price">Harga Jual</span>
                  <span class="spbu-sep">:</span>
                  <span class="spbu-val-num" id="t-spbu-price-jual">10,000</span>
                </div>
              </div>

              <!-- Total Penjualan Section -->
              <div class="spbu-section" style="margin-top: 5px;">
                <div class="spbu-section-title">Total Penjualan (Rp)</div>
                <div class="spbu-col-row">
                  <span class="spbu-label-price">Tanpa Subsidi</span>
                  <span class="spbu-sep">:</span>
                  <span class="spbu-val-num" id="t-spbu-tot-nonsubsidi">54,303</span>
                </div>
                <div class="spbu-col-row">
                  <span class="spbu-label-price">Subsidi Pemerintah</span>
                  <span class="spbu-sep">:</span>
                  <span class="spbu-val-num" id="t-spbu-tot-subsidi">24,303</span>
                </div>
                <div class="spbu-col-row">
                  <span class="spbu-label-price">Dibayar Konsumen</span>
