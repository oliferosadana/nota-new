---
---
<div class="modal-backdrop" id="auth-modal" role="dialog" aria-modal="true" aria-labelledby="auth-modal-title">
  <div class="modal-box" style="max-width: 480px;">
    <div class="modal-header">
      <h3 class="modal-title" id="auth-modal-title">🔐 Autentikasi Pengguna & Cloud Supabase</h3>
      <button type="button" class="btn btn-outline btn-sm" id="btn-close-auth" aria-label="Tutup jendela">✕</button>
    </div>

    <!-- Auth Tabs -->
    <div class="template-pills" style="margin-bottom: 16px;">
      <button type="button" class="template-pill active" id="tab-btn-login">Masuk</button>
      <button type="button" class="template-pill" id="tab-btn-register">Daftar Baru</button>
      <button type="button" class="template-pill" id="tab-btn-config">Koneksi Supabase</button>
    </div>

    <!-- Feedback / Alert Message -->
    <div id="auth-alert" style="display: none; padding: 10px 14px; border-radius: var(--radius-sm); font-size: 0.82rem; margin-bottom: 14px; line-height: 1.4;"></div>

    <!-- Tab 1: Login Form -->
    <form id="form-login" class="form-grid" style="grid-template-columns: 1fr;" novalidate>
      <div class="form-group">
        <label for="login-email">Alamat Email</label>
        <input type="email" id="login-email" placeholder="nama@toko.com" required autocomplete="email" />
      </div>
      <div class="form-group">
        <label for="login-password">Kata Sandi</label>
        <input type="password" id="login-password" placeholder="••••••••" required autocomplete="current-password" />
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 4px;">
        <button type="button" class="btn btn-link" id="btn-forgot-password" style="padding: 0; background: none; border: none; color: #60a5fa; font-size: 0.78rem; text-decoration: underline; cursor: pointer;">
          Lupa kata sandi?
        </button>
      </div>
      <button type="submit" class="btn btn-primary" id="btn-submit-login" style="margin-top: 8px;">
        <span aria-hidden="true">🔓</span> Masuk ke Akun
      </button>
    </form>

    <!-- Tab 2: Register Form -->
    <form id="form-register" class="form-grid" style="grid-template-columns: 1fr; display: none;" novalidate>
      <div class="form-group">
        <label for="reg-name">Nama Lengkap / Nama Kasir</label>
        <input type="text" id="reg-name" placeholder="Contoh: Rina atau Kasir 01" required autocomplete="name" />
      </div>
      <div class="form-group">
        <label for="reg-email">Alamat Email</label>
        <input type="email" id="reg-email" placeholder="nama@toko.com" required autocomplete="email" />
      </div>
      <div class="form-group">
        <label for="reg-password">Kata Sandi (Minimal 6 karakter)</label>
        <input type="password" id="reg-password" placeholder="••••••••" required autocomplete="new-password" minlength="6" />
      </div>
      <div class="form-group">
        <label for="reg-confirm-password">Ulangi Kata Sandi</label>
        <input type="password" id="reg-confirm-password" placeholder="••••••••" required autocomplete="new-password" minlength="6" />
      </div>
      <button type="submit" class="btn btn-emerald" id="btn-submit-register" style="margin-top: 8px;">
        <span aria-hidden="true">✨</span> Daftarkan Akun Baru
      </button>
    </form>

    <!-- Tab 3: Supabase Config Settings -->
    <form id="form-config" class="form-grid" style="grid-template-columns: 1fr; display: none;" novalidate>
      <div class="form-group">
        <label for="cfg-supabase-url">Supabase Project URL</label>
        <input type="url" id="cfg-supabase-url" placeholder="https://xyzcompany.supabase.co" required />
      </div>
      <div class="form-group">
        <label for="cfg-supabase-key">Supabase Publishable / Anon Key</label>
        <input type="text" id="cfg-supabase-key" placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." required />
      </div>
      <div style="display: flex; gap: 8px; margin-top: 8px;">
        <button type="submit" class="btn btn-primary btn-sm" id="btn-save-config" style="flex: 1;">
          <span aria-hidden="true">💾</span> Simpan Konfigurasi
        </button>
        <button type="button" class="btn btn-outline btn-sm" id="btn-reset-config">
          <span aria-hidden="true">🔄</span> Default
        </button>
      </div>
    </form>
  </div>
</div>
